# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: VSoft.AnsiConsole
  version: 0.3.0
  description: 'A Delphi library for writing rich, interactive console applications. Tables, trees, live progress, prompts, syntax-coloured exceptions, ANSI colour, hyperlinks, emoji, FIGlet text, calendars, charts, recorder + HTML export — composable widgets that render through a unified pipeline.'
  authors:
    - Vincent Parrett
  projectUrl: https://github.com/VSoftTechnologies/VSoft.AnsiConsole
  repositoryUrl: https://github.com/VSoftTechnologies/VSoft.AnsiConsole
  repositoryCommit: 81fd7578123815367b8cff4c6adb03f8d89535aa
  license: MIT
  copyright: Vincent Parrett and contributors
  tags:
    - console
    - terminal
    - ansi
  readme: README.md
variables:
  packagesource: RAD Studio $compilernoprefix$
targetPlatforms:
  - compiler from: delphixe3
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
templates:
  - name: default
    dependencies:
      - id: VSoft.System.Console
        version: '[1.2.4,]'
    source:
      - src: ./LICENSE
      - src: ./source/**.pas
      - src: ./Packages/$packageSource$/*.dpk
      - src: ./Packages/$packageSource$/*.dproj
    build:
      - project: ./Packages/$packageSource$/VSoft.AnsiConsoleR.dproj
